{
  "expo": {
    "name": "chat-app-bc",
    "slug": "chat-app-bc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ung dung can quyen truy cap thu vien anh de gui hinh anh va doi anh dai dien."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7e7488e6-5929-4148-8cc1-f5724b0449d2"
      }
    },
    "owner": "binhnguyencnit"
  }
}
